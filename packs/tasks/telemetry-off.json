  "tier": "pro",
  "risk": "safe",
  "requiresReboot": false,
  "supports": {
    "minBuild": 19045,
    "maxBuild": null,
    "editions": ["Home", "Pro", "Enterprise", "Education"],
    "deviceClass": ["desktop", "laptop"],
    "gpuVendor": null
  },
  "conflictsWith": [],
  "dependsOn": [],
  "irreversible": false,
  "benchmarkHint": "none",
  "actions": [
    {
      "type": "task.disable",
      "path": "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser"
    },
    {
      "type": "task.disable",
      "path": "\\Microsoft\\Windows\\Application Experience\\ProgramDataUpdater"
    },
    {
      "type": "task.disable",
      "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\Consolidator"
