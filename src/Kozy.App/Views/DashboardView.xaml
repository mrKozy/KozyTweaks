<UserControl x:Class="Kozy.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Kozy.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="System-Übersicht" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Hardware-Status und Schnell-Optimierungen auf einen Blick." Foreground="#8A8886" Margin="0,0,0,24" />

            <!-- System Info Cards Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <!-- OS Card -->
                <ui:Card Margin="0,0,10,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Betriebssystem" FontWeight="SemiBold" Foreground="#8A8886" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding OsName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OsBuildString}" FontSize="12" Foreground="#8A8886" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Device Type -->
                <ui:Card Margin="10,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Gerätetyp" FontWeight="SemiBold" Foreground="#8A8886" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DeviceTypeString}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Vollständig kompatibel mit allen Tweaks" FontSize="12" Foreground="#107C41" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- CPU Card -->
                <ui:Card Margin="0,0,10,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Prozessor (CPU)" FontWeight="SemiBold" Foreground="#8A8886" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CpuName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RamString}" FontSize="12" Foreground="#8A8886" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- GPU Card -->
                <ui:Card Margin="10,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Grafikkarte (GPU)" FontWeight="SemiBold" Foreground="#8A8886" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding GpuName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Treiber- und Display-Optimierungen verfügbar" FontSize="12" Foreground="#8A8886" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Status Card -->
            <ui:Card Margin="0,0,0,24" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Optimierungs-Status" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#CCCCCC" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Aktualisieren" Command="{Binding RefreshStatusCommand}" Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Quick Actions Section -->
            <TextBlock Text="Schnellaktionen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <ui:Card Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Sicheres Preset anwenden" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Aktiviert alle risikoarmen Tweaks für sofort verbesserte Latenz und Bildraten." 
                                   Foreground="#8A8886" TextWrapping="Wrap" Margin="0,0,0,16" MinHeight="36"/>
                        <ui:Button Content="Sicheres Preset aktivieren" 
                                   Appearance="Primary"
                                   Command="{Binding ApplySafePresetCommand}" 
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="10,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Wiederherstellungspunkt" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Erstellt manuell einen Windows Systemwiederherstellungspunkt vor tiefgreifenden Änderungen." 
                                   Foreground="#8A8886" TextWrapping="Wrap" Margin="0,0,0,16" MinHeight="36"/>
                        <ui:Button Content="Punkt jetzt erstellen" 
                                   Command="{Binding CreateRestorePointCommand}" 
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
