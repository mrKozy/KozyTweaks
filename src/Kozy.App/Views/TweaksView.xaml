<UserControl x:Class="Kozy.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Kozy.App.ViewModels"
             xmlns:m="clr-namespace:Kozy.App.Models"
             d:DataContext="{d:DesignInstance vm:TweaksViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="System Optimizations (Tweaks)" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="Select a preset or configure individual options granularly." 
                   Foreground="#8A8886" Margin="0,32,0,16" />

        <!-- Controls Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Presets Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Presets:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#8A8886"/>
                <ui:Button Content="Safe" Command="{Binding SelectPresetCommand}" CommandParameter="Safe" Margin="0,0,6,0"/>
                <ui:Button Content="Balanced" Command="{Binding SelectPresetCommand}" CommandParameter="Balanced" Margin="0,0,6,0"/>
                <ui:Button Content="Max" Command="{Binding SelectPresetCommand}" CommandParameter="Max" Margin="0,0,16,0"/>
            </StackPanel>

            <!-- Search box -->
            <ui:TextBox Grid.Column="1" 
                        PlaceholderText="Search by name, ID or description..." 
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,16,0" 
                        VerticalAlignment="Center" />

            <!-- Category filter -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#8A8886"/>
                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}" 
                          MinWidth="120" 
                          VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Tweaks List -->
        <Border Grid.Row="2" Background="#1F1F1F" CornerRadius="8" Padding="4">
            <ListView ItemsSource="{Binding FilteredItems}" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:TweakItemViewModel}">
                        <ui:Card Margin="4,4,4,4" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Selection Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Tweak Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="0,0,8,0"/>

                                        <!-- Category Tag -->
                                        <Border Background="#2B2B2B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#AAAAAA" />
                                        </Border>

                                        <!-- Risk Tag -->
                                        <Border CornerRadius="4" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#333333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskLabel}" Value="Safe">
                                                            <Setter Property="Background" Value="#1E3A2B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLabel}" Value="Moderate">
                                                            <Setter Property="Background" Value="#3D2D1B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLabel}" Value="Experimental">
                                                            <Setter Property="Background" Value="#3D1B1B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLabel}" Value="Safe">
                                                                <Setter Property="Foreground" Value="#57D98D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RiskLabel}" Value="Moderate">
                                                                <Setter Property="Foreground" Value="#FFB356"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RiskLabel}" Value="Experimental">
                                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#999999" FontSize="12" Margin="0,0,10,0"/>
                                </StackPanel>

                                <!-- Applied Indicator -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Active" FontWeight="SemiBold" FontSize="12" Foreground="#57D98D" 
                                               Visibility="{Binding IsApplied, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="Inactive" FontSize="12" Foreground="#666666" 
                                               Visibility="{Binding IsApplied, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12,16" Background="#181818" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} optimization(s) selected'}" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Margin="0,0,10,0"/>
                    <ui:Button Command="{Binding RevertSelectedCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Revert" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Primary" Command="{Binding ApplySelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Apply Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
