<ui:FluentWindow x:Class="Kozy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Kozy.App.ViewModels"
        mc:Ignorable="d"
        Title="kozy - Windows Optimizer" 
        Height="760" Width="1160"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#181818">
    <Window.Resources>
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="10,0" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Indicator" 
                                        Width="3" Height="18" 
                                        HorizontalAlignment="Left" 
                                        Background="#107C41" 
                                        CornerRadius="1.5" 
                                        Margin="-4,0,0,0" 
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="kozy - Windows Optimizer" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#262626" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Branding Header -->
                    <StackPanel Grid.Row="0" Margin="20,16,20,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="kozy" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,8,0" />
                            <Border Background="#107C41" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="FREE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Windows Performance Tool" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <RadioButton x:Name="NavDashboard" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     IsChecked="True"
                                     Click="NavButton_Click" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTweaks" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Tweaks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Tweaks" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavCleaner" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Cleaner">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Broom24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Cleaner" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAutostart" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Autostart">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Rocket24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Startup Apps" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavBenchmark" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Benchmark">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Benchmarks" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavHistory" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="History">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="History &amp; Rollback" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer Settings -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,16">
                        <Separator Background="#262626" Margin="0,0,0,12"/>
                        <RadioButton x:Name="NavSettings" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
