<ui:FluentWindow x:Class="Kozy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Kozy.App.ViewModels"
        mc:Ignorable="d"
        Title="kozy - Windows Optimizer" 
        Height="760" Width="1160"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#181818">
    <Window.Resources>
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="10,0" 
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Indicator" 
                                        Width="3" Height="18" 
                                        HorizontalAlignment="Left" 
                                        Background="#107C41" 
                                        CornerRadius="1.5" 
                                        Margin="-4,0,0,0" 
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="kozy - Windows Optimizer" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#262626" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Branding Header -->
                    <StackPanel Grid.Row="0" Margin="20,16,20,20">
                        <TextBlock Text="kozy" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Windows Performance Tool" FontSize="11" Foreground="#666666" Margin="0,2,0,10"/>

                        <!-- Creator Credit -->
                        <Border Background="#1C1C1C" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="AuthorCredit_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" 
                                      Fill="#CCCCCC" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="made by " FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                <TextBlock Text="mrKozy" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <RadioButton x:Name="NavDashboard" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     IsChecked="True"
                                     Click="NavButton_Click" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTweaks" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Tweaks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Tweaks" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavCleaner" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Cleaner">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Broom24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Cleaner" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAutostart" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Autostart">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Rocket24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Startup Apps" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavBenchmark" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Benchmark">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Benchmarks" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavHistory" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="History">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="History &amp; Rollback" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer Settings -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,16">
                        <Separator Background="#262626" Margin="0,0,0,12"/>
                        <RadioButton x:Name="NavSettings" 
                                     Style="{StaticResource NavRadioButtonStyle}" 
                                     Click="NavButton_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
